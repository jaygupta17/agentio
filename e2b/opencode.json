{
  "$schema": "https://opencode.ai/config.json",
  // agentio stencil — installed once by boot.sh when the user has no config.
  // Never overwritten afterwards; user edits via the PWA config manager.
  // Remote sessions are private to this sandbox.
  "share": "disabled",
  // session -> subagent -> sub-subagent (spec: depth 2-3, start at 2)
  "subagent_depth": 2,
  // Spec auto-approve default: agents run uninterrupted; the PWA approvals
  // UI still renders anything explicitly set to "ask". doom_loop stays ask —
  // stuck-loop recovery prompts are a safety rail, not workflow friction.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "doom_loop": "ask"
  }
}
